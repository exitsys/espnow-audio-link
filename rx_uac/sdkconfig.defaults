CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 注：ESP32-S3 的 I2S 时钟源只有 XTAL / PLL_160M / PLL_240M / EXTERNAL，
# 硬件上并没有把 APLL 接到 I2S（那是 ESP32 / ESP32-S2 / ESP32-P4 才有的）。
# 时钟源不在这里配，由 rx_uac/main/alink_rx.c 的 ALINK_I2S_CLK_240M 选，
# 当前是 PLL_240M（12.288MHz 可以整数分频，BCK 没有周期性抖动；原因见那一段注释）。
#
# 顺带澄清一个曾经的误判：160MHz / 3.072MHz = 52 + 1/12，分母 12 ≤ 63，
# IDF 的小数分频器能精确表达，本身不产生 pattern jitter。
# 也就是说 S3 和 C3 在 I2S 时钟精度上没有差别，它不是差异来源。
